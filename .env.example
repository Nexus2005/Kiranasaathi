DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
POSTGRES_HOST=db.YOUR_PROJECT.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Smart Counter (client-side camera barcode scanning) ----
# Detection runs entirely in the browser (native BarcodeDetector, ZXing fallback).
# Frames never leave the device; only the resolved barcode string hits the API.
NEXT_PUBLIC_COUNTER_SCAN_INTERVAL_MS=450
NEXT_PUBLIC_COUNTER_REPEAT_LOCKOUT_MS=2500

# ---- Smart Counter vision pipeline (server-side; OPTIONAL — see docs/smart-counter-models.md) ----
# Leave empty to run honestly without visual recognition (camera barcode scan still works).
# Inference host example (single-product counter slice, all Apache-2.0):
#   COUNTER_DETECTOR_PROVIDER=fullframe
#   COUNTER_BARCODE_PROVIDER=zxing
#   COUNTER_EMBEDDING_PROVIDER=torch
COUNTER_DETECTOR_PROVIDER=            # nvidia | yolo | fullframe | (empty)
COUNTER_BARCODE_PROVIDER=             # zxing | pyzbar | (empty)
COUNTER_EMBEDDING_PROVIDER=           # torch | (empty)
COUNTER_OCR_PROVIDER=                 # paddleocr | (empty)
COUNTER_NVIDIA_URL=                   # Triton infer endpoint (nvidia provider)
COUNTER_YOLO_WEIGHTS=                 # path to .pt weights (yolo provider)
COUNTER_EMBEDDING_MODEL=vit_small_patch14_dinov2
COUNTER_EMBEDDING_INPUT_SIZE=224      # timm DINOv2 needs img_size set (native 518)
COUNTER_FULLFRAME_COVERAGE=0.8        # fullframe detector: central region fraction
COUNTER_DEVICE=                       # cuda | cpu | (empty = auto)
COUNTER_TOP_K=5
COUNTER_AUTO_ADD_THRESHOLD=0.95
COUNTER_REVIEW_THRESHOLD=0.70
COUNTER_MATCH_SINGLE_SIGNAL_FLOOR=0.30  # visual-only matches can reach REVIEW (0.65*sim + 0.30)
COUNTER_MAX_IMAGE_MB=6
COUNTER_MAX_IMAGE_WIDTH=1920
COUNTER_MAX_IMAGE_HEIGHT=1920
COUNTER_MAX_DETECTIONS=12
COUNTER_DETECTION_MIN_CONFIDENCE=0.5
COUNTER_OCR_LANG=en
# Test-only mock providers (require BOTH vars; refused otherwise):
# COUNTER_ENV=test
# COUNTER_ALLOW_MOCK_VISION=1
